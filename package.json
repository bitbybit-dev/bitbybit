{
    "name": "bitbybit",
    "version": "1.2.0",
    "private": true,
    "description": "Monorepo for browser CAD which holds bitbybit.dev npm packages",
    "packageManager": "pnpm@11.25.0",
    "main": "index.js",
    "scripts": {
        "ci-packages": "pnpm install --frozen-lockfile",
        "rm-dist-packages": "pnpm -r run clean-dist",
        "build-packages": "pnpm -r run build-p",
        "rebuild-all-packages": "npm run rm-dist-packages && npm run build-packages",
        "watch-packages": "tsc -b tsconfig.build.json --watch",
        "install-rebuild-all-packages": "npm run ci-packages && npm run rebuild-all-packages",
        "test-base": "cd packages/dev/base && npm run test:coverage",
        "test-occt": "cd packages/dev/occt && npm run test:coverage",
        "test-core": "cd packages/dev/core && npm run test:coverage",
        "test-jscad": "cd packages/dev/jscad && npm run test:coverage",
        "test-manifold": "cd packages/dev/manifold && npm run test:coverage",
        "test-threejs": "cd packages/dev/threejs && npm run test:coverage",
        "test-playcanvas": "cd packages/dev/playcanvas && npm run test:coverage",
        "test-babylonjs": "cd packages/dev/babylonjs && npm run test:coverage",
        "test-occt-worker": "cd packages/dev/occt-worker && npm run test:coverage",
        "test-jscad-worker": "cd packages/dev/jscad-worker && npm run test:coverage",
        "test-manifold-worker": "cd packages/dev/manifold-worker && npm run test:coverage",
        "gen:references": "node scripts/gen-ts-references.mjs",
        "check:references": "node scripts/gen-ts-references.mjs --check",
        "gen:exports": "node scripts/gen-exports.mjs",
        "check:exports": "node scripts/check-exports.mjs",
        "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
        "lint:fix": "eslint --cache --cache-location ./node_modules/.cache/eslint . --fix",
        "typecheck:strict": "tsc -b tsconfig.build.json && pnpm -r run typecheck:strict",
        "typecheck:tests": "pnpm -r run typecheck:tests",
        "check:strict-baselines": "node scripts/check-strict-baselines.mjs",
        "check:worker-parity": "node scripts/worker-parity.mjs",
        "gen:worker-api": "node scripts/gen-worker-api.mjs",
        "check:worker-api": "node scripts/gen-worker-api.mjs --check",
        "gen:inputs": "node scripts/gen-inputs.mjs",
        "check:inputs": "node scripts/gen-inputs.mjs --check",
        "check:draw-parity": "node scripts/check-draw-parity.mjs",
        "test": "npm run check:references && npm run check:exports && npm run check:inputs && npm run check:draw-parity && npm run check:worker-api && npm run check:worker-parity && npm run test-occt && npm run test-base && npm run test-core && npm run test-jscad && npm run test-manifold && npm run test-threejs && npm run test-playcanvas && npm run test-babylonjs && npm run test-occt-worker && npm run test-jscad-worker && npm run test-manifold-worker",
        "test:report": "node scripts/test-report.mjs --expect \"packages/dev/*\" --baseline packages/dev/coverage-baseline.json --logo docs/static/img/logo-gold-small.png",
        "check:coverage-baseline": "node scripts/coverage-baseline.mjs",
        "coverage-baseline:save": "node scripts/coverage-baseline.mjs --save",
        "refresh-lockfile": "pnpm install --lockfile-only",
        "setup": "npm run install-rebuild-all-packages",
        "setup-and-test": "npm run setup && npm run test",
        "first-time-setup": "npm run setup-and-test",
        "api:check": "pnpm -r run api:check",
        "api:update": "pnpm -r run api:update",
        "check:tarballs": "node scripts/check-tarballs.mjs",
        "check:openapi": "node scripts/check-openapi.mjs",
        "check:advisories": "node scripts/check-advisories.mjs",
        "kernels:fetch": "node scripts/fetch-kernels.mjs",
        "kernels:check": "node scripts/fetch-kernels.mjs --check",
        "publish:packages": "node scripts/publish-packages.mjs",
        "examples:status": "cd examples && node scripts/local.mjs status",
        "examples:link": "cd examples && node scripts/local.mjs link",
        "examples:unlink": "cd examples && node scripts/local.mjs unlink",
        "examples:dev": "cd examples && node scripts/local.mjs dev",
        "examples:build": "cd examples && node scripts/local.mjs build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bitbybit-dev/bitbybit.git"
    },
    "keywords": [
        "CAD",
        "3D",
        "Geometry",
        "OCCT",
        "JSCAD",
        "Manifold",
        "ThreeJS",
        "PlayCanvas",
        "BabylonJS",
        "Automotive",
        "AEC"
    ],
    "author": "Bit By Bit Developers",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/bitbybit-dev/bitbybit/issues"
    },
    "homepage": "https://bitbybit.dev",
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "26.5.0",
        "eslint": "10.10.0",
        "globals": "17.12.0",
        "shx": "^0.4.0",
        "tsc-baseline": "2.1.0",
        "typescript": "5.9.3",
        "typescript-eslint": "8.69.0",
        "vitest": "4.1.11"
    }
}
