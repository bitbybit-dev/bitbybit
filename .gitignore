node_modules

# Agent tooling - never publish local session logs or settings
.claude/

# Per-suite JSON results the runners write for scripts/test-report.mjs
test-results/

# Coverage reports. Each package ignores its own; this catches the whole tree, including a report
# written at the root by a coverage run started from here rather than from inside a package.
coverage/

packages/dev/ifc/corpus/files/
packages/dev/ifc/corpus/.cache/

# written by Python when validate.py imports the validation checker
__pycache__/
