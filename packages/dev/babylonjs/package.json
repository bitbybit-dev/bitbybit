{
  "name": "@bitbybit-dev/babylonjs",
  "version": "1.1.1",
  "description": "Bit By Bit Developers BABYLONJS CAD Library to Program Geometry",
  "homepage": "https://docs.bitbybit.dev/classes/Bit.Babylon",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/bitbybit-dev/bitbybit"
  },
  "keywords": [
    "Bit By Bit Developers",
    "bitbybit",
    "bitbybit.dev",
    "Geometry",
    "CAD",
    "3D",
    "JSCAD",
    "OCCT",
    "OpenCascade",
    "Creative coding",
    "BabylonJS",
    "WebGL",
    "WebGPU",
    "Parametric",
    "Modeling",
    "Browser CAD",
    "3D algorithms",
    "3D modeling",
    "3D printing",
    "3D printing algorithms",
    "3D software",
    "OpenCascade Technology",
    "AEC",
    "Automotive",
    "Engineering",
    "CAE",
    "CAM"
  ],
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "build": "tsc -p tsconfig.bitbybit.json",
    "build-p": "npm run build && npm run copy-package && npm run copy-readme && npm run delete-coverage",
    "copy-package": "node ../../../scripts/dist-manifest.mjs",
    "copy-readme": "shx cp -R ./README.md ./dist && shx cp -R ./LICENSE ./dist",
    "delete-coverage": "shx rm -rf ./dist/coverage || true",
    "test": "NODE_OPTIONS=--max-old-space-size=8192 jest --watchAll=true",
    "test-c": "NODE_OPTIONS=--max-old-space-size=8192 jest --coverage --watchAll=false",
    "test-c-l": "NODE_OPTIONS=--max-old-space-size=8192 jest --coverage --watchAll=true"
  },
  "author": "Bit by bit developers",
  "license": "MIT",
  "funding": {
    "type": "corporate",
    "url": "https://bitbybit.dev/auth/pick-plan"
  },
  "types": "./index.d.ts",
  "type": "module",
  "dependencies": {
    "@bitbybit-dev/core": "1.1.1",
    "@bitbybit-dev/base": "1.1.1",
    "@bitbybit-dev/occt-worker": "1.1.1",
    "@bitbybit-dev/jscad-worker": "1.1.1",
    "@bitbybit-dev/manifold-worker": "1.1.1",
    "jsonpath-plus": "10.3.0",
    "verb-nurbs-web": "2.1.3"
  },
  "peerDependencies": {
    "@babylonjs/core": "9.13.0",
    "@babylonjs/gui": "9.13.0",
    "@babylonjs/havok": "1.3.13",
    "@babylonjs/loaders": "9.13.0",
    "@babylonjs/materials": "9.13.0",
    "@babylonjs/serializers": "9.13.0",
    "earcut": "3.0.2"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/preset-env": "7.29.5",
    "@babel/preset-typescript": "7.28.5",
    "@testing-library/jest-dom": "6.9.1",
    "@types/jest": "30.0.0",
    "babel-jest": "30.4.1",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "jest-html-reporters": "3.1.7",
    "shx": "0.4.0",
    "ts-jest": "29.4.10",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "transform": {
      "\\.[jt]sx?$": "babel-jest"
    },
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!\\.pnpm|@babylonjs|@bitbybit-dev|earcut)"
    ],
    "moduleNameMapper": {
      "^@bitbybit-dev/base$": "<rootDir>/../base/dist/index.js",
      "^@bitbybit-dev/base/(.*)$": "<rootDir>/../base/dist/$1",
      "^@bitbybit-dev/core$": "<rootDir>/../core/dist/index.js",
      "^@bitbybit-dev/core/(.*)$": "<rootDir>/../core/dist/$1",
      "^@bitbybit-dev/jscad$": "<rootDir>/../jscad/dist/index.js",
      "^@bitbybit-dev/jscad/(.*)$": "<rootDir>/../jscad/dist/$1",
      "^@bitbybit-dev/manifold$": "<rootDir>/../manifold/dist/index.js",
      "^@bitbybit-dev/manifold/(.*)$": "<rootDir>/../manifold/dist/$1",
      "^@bitbybit-dev/jscad-worker$": "<rootDir>/../jscad-worker/dist/index.js",
      "^@bitbybit-dev/jscad-worker/(.*)$": "<rootDir>/../jscad-worker/dist/$1",
      "^@bitbybit-dev/manifold-worker$": "<rootDir>/../manifold-worker/dist/index.js",
      "^@bitbybit-dev/manifold-worker/(.*)$": "<rootDir>/../manifold-worker/dist/$1",
      "^@bitbybit-dev/occt-worker$": "<rootDir>/../occt-worker/dist/index.js",
      "^@bitbybit-dev/occt-worker/(.*)$": "<rootDir>/../occt-worker/dist/$1",
      "bitbybit-dev-occt/bitbybit-dev-occt(\\.js)?$": "<rootDir>/__mocks__/occt-glue.ts"
    },
    "collectCoverageFrom": [
      "lib/workers/**/*",
      "lib/api/**/*"
    ]
  }
}
