// The editor and test view of this package. The build (tsconfig.bitbybit.json) enforces the whole
// strict set of tsconfig.base.cad-strict.json, ahead of the shared loose base, the way base and occt
// did. It carries no strict baseline any more. The flags are repeated here so the editor and the tests
// hold the same line; the build config cannot carry this note because the references generator
// rewrites it without comments.
{
    "extends": "../../../tsconfig.base.cad-loose.json",
    "compileOnSave": false,
    "compilerOptions": {
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noImplicitReturns": true,
        "noImplicitOverride": true,
        "noPropertyAccessFromIndexSignature": true,
        "isolatedModules": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "./dist/bitbybit-dev",
        "baseUrl": "./",
        "paths": {
            "@bitbybit-dev/base": [
                "../base/dist"
            ],
            "@bitbybit-dev/base/*": [
                "../base/dist/*"
            ],
            "@bitbybit-dev/core": [
                "../core/dist"
            ],
            "@bitbybit-dev/core/*": [
                "../core/dist/*"
            ],
            "@bitbybit-dev/jscad": [
                "../jscad/dist"
            ],
            "@bitbybit-dev/jscad/*": [
                "../jscad/dist/*"
            ],
            "@bitbybit-dev/jscad-worker": [
                "../jscad-worker/dist"
            ],
            "@bitbybit-dev/jscad-worker/*": [
                "../jscad-worker/dist/*"
            ],
            "@bitbybit-dev/manifold": [
                "../manifold/dist"
            ],
            "@bitbybit-dev/manifold/*": [
                "../manifold/dist/*"
            ],
            "@bitbybit-dev/manifold-worker": [
                "../manifold-worker/dist"
            ],
            "@bitbybit-dev/manifold-worker/*": [
                "../manifold-worker/dist/*"
            ],
            "@bitbybit-dev/occt": [
                "../occt/dist"
            ],
            "@bitbybit-dev/occt/*": [
                "../occt/dist/*"
            ],
            "@bitbybit-dev/occt-worker": [
                "../occt-worker/dist"
            ],
            "@bitbybit-dev/occt-worker/*": [
                "../occt-worker/dist/*"
            ]
        }
    }
}