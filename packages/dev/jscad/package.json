{
    "name": "@bitbybit-dev/jscad",
    "version": "1.1.1",
    "description": "Bit By Bit Developers JSCAD based CAD Library to Program Geometry",
    "homepage": "https://docs.bitbybit.dev/classes/Bit.JSCAD",
    "main": "index.js",
    "repository": {
        "type": "git",
        "url": "https://github.com/bitbybit-dev/bitbybit"
    },
    "keywords": [
        "Bit By Bit Developers",
        "bitbybit",
        "bitbybit.dev",
        "Geometry",
        "CAD",
        "3D",
        "JSCAD",
        "OCCT",
        "OpenCascade",
        "Creative coding",
        "CSG",
        "Mesh",
        "Meshing",
        "Manifold",
        "Manifold-3D",
        "WebGL",
        "WebGPU",
        "Parametric",
        "Modeling",
        "Browser CAD",
        "3D algorithms",
        "3D modeling",
        "3D printing",
        "3D printing algorithms",
        "3D software",
        "OpenCascade Technology",
        "AEC",
        "Automotive",
        "Engineering",
        "CAE",
        "CAM"
    ],
    "directories": {
        "lib": "lib"
    },
    "scripts": {
        "build": "tsc -b tsconfig.bitbybit.json",
        "typecheck:strict": "tsc -p tsconfig.strict.json --pretty false | tsc-baseline check",
        "typecheck:strict:save": "tsc -p tsconfig.strict.json --pretty false | tsc-baseline --ignoreMessages save",
        "clean-dist": "shx rm -rf dist",
        "build-p": "npm run build && npm run copy-package && npm run copy-readme && npm run delete-coverage",
        "copy-package": "node ../../../scripts/dist-manifest.mjs",
        "copy-readme": "shx cp -R ./README.md ./dist && shx cp -R ./LICENSE ./dist",
        "delete-coverage": "shx rm -rf ./dist/coverage || true",
        "test": "NODE_OPTIONS=--max-old-space-size=8192 jest --watchAll=true",
        "test-c": "mkdir -p test-results && NODE_OPTIONS=--max-old-space-size=8192 jest --coverage --watchAll=false --json --outputFile=test-results/jest.json",
        "test-c-l": "NODE_OPTIONS=--max-old-space-size=8192 jest --coverage --watchAll=true"
    },
    "author": "Bit by bit developers",
    "license": "MIT",
    "funding": {
        "type": "corporate",
        "url": "https://bitbybit.dev/auth/pick-plan"
    },
    "types": "./index.d.ts",
    "type": "module",
    "dependencies": {
        "@bitbybit-dev/base": "1.1.1",
        "@jscad/io-utils": "2.0.28",
        "@jscad/modeling": "2.12.3",
        "@jscad/stl-serializer": "2.1.18",
        "@jscad/dxf-serializer": "2.1.18",
        "@jscad/3mf-serializer": "2.1.12"
    },
    "devDependencies": {
        "shx": "0.4.0",
        "@testing-library/jest-dom": "6.9.1",
        "jest": "30.4.2",
        "ts-node": "10.9.2",
        "ts-jest": "29.4.10",
        "typescript": "5.9.3",
        "@types/jest": "30.0.0",
        "babel-jest": "30.4.1",
        "@babel/core": "7.28.6",
        "@babel/preset-env": "7.28.6",
        "@babel/preset-typescript": "7.28.5",
        "jest-html-reporters": "3.1.7",
        "jest-environment-node": "30.4.1"
    },
    "jest": {
        "preset": "ts-jest",
        "transform": {
            "\\.[jt]sx?$": "babel-jest"
        },
        "extensionsToTreatAsEsm": [
            ".ts"
        ],
        "transformIgnorePatterns": [
            "node_modules/(?!\\.pnpm|@bitbybit-dev)/"
        ],
        "collectCoverageFrom": [
            "lib/api/**/*"
        ],
        "coverageReporters": [
            "text",
            "lcov",
            "json-summary"
        ]
    }
}
