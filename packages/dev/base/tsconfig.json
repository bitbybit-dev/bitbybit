// The editor and test view of this package. The build (tsconfig.bitbybit.json) enforces the whole
// strict set of tsconfig.base.cad-strict.json, ahead of the shared loose base: base is the root of the
// package graph, so the types it declares reach every other package, and it went strict first, one
// flag at a time. It carries no strict baseline any more. The flags are repeated here so the editor and
// the tests hold the same line; the build config cannot carry this note because the references
// generator rewrites it without comments.
{
    "extends": "../../../tsconfig.base.cad-loose.json",
    "compileOnSave": false,
    "compilerOptions": {
        "outDir": "./dist/bitbybit-dev",
        "baseUrl": "./",
        "paths": {},
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noImplicitReturns": true,
        "noImplicitOverride": true,
        "noPropertyAccessFromIndexSignature": true,
        "isolatedModules": true,
        "forceConsistentCasingInFileNames": true
    }
}
