{
  "name": "@bitbybit-dev/base",
  "version": "1.1.1",
  "description": "Bit By Bit Developers Base CAD Library to Program Geometry",
  "homepage": "https://docs.bitbybit.dev/modules/Bit",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitbybit-dev/bitbybit.git",
    "directory": "packages/dev/base"
  },
  "keywords": [
    "Bit By Bit Developers",
    "bitbybit",
    "bitbybit.dev",
    "Geometry",
    "CAD",
    "3D",
    "JSCAD",
    "OCCT",
    "OpenCascade",
    "Creative coding",
    "CSG",
    "Mesh",
    "Meshing",
    "Manifold",
    "Manifold-3D",
    "WebGL",
    "WebGPU",
    "Parametric",
    "Modeling",
    "Browser CAD",
    "3D algorithms",
    "3D modeling",
    "3D printing",
    "3D printing algorithms",
    "3D software",
    "OpenCascade Technology",
    "AEC",
    "Automotive",
    "Engineering",
    "CAE",
    "CAM"
  ],
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "build": "tsc -b tsconfig.bitbybit.json",
    "typecheck:strict": "tsc -p tsconfig.strict.json --pretty false",
    "clean-dist": "shx rm -rf dist",
    "build-p": "npm run build && npm run copy-package && npm run copy-readme && npm run delete-coverage",
    "copy-package": "node ../../../scripts/dist-manifest.mjs",
    "copy-readme": "shx cp -R ./README.md ./dist && shx cp -R ./LICENSE ./dist",
    "delete-coverage": "shx rm -rf ./dist/coverage || true",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local"
  },
  "author": "Bit by bit developers",
  "license": "MIT",
  "funding": {
    "type": "corporate",
    "url": "https://bitbybit.dev/auth/pick-plan"
  },
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "@bitbybit-dev/source": "./index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lib": {
      "@bitbybit-dev/source": "./lib/index.ts",
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    },
    "./lib/api": {
      "@bitbybit-dev/source": "./lib/api/index.ts",
      "types": "./dist/lib/api/index.d.ts",
      "default": "./dist/lib/api/index.js"
    },
    "./lib/api/inputs": {
      "@bitbybit-dev/source": "./lib/api/inputs/index.ts",
      "types": "./dist/lib/api/inputs/index.d.ts",
      "default": "./dist/lib/api/inputs/index.js"
    },
    "./lib/api/models": {
      "@bitbybit-dev/source": "./lib/api/models/index.ts",
      "types": "./dist/lib/api/models/index.d.ts",
      "default": "./dist/lib/api/models/index.js"
    },
    "./lib/api/models/point": {
      "@bitbybit-dev/source": "./lib/api/models/point/index.ts",
      "types": "./dist/lib/api/models/point/index.d.ts",
      "default": "./dist/lib/api/models/point/index.js"
    },
    "./lib/api/models/text": {
      "@bitbybit-dev/source": "./lib/api/models/text/index.ts",
      "types": "./dist/lib/api/models/text/index.d.ts",
      "default": "./dist/lib/api/models/text/index.js"
    },
    "./lib/api/services": {
      "@bitbybit-dev/source": "./lib/api/services/index.ts",
      "types": "./dist/lib/api/services/index.d.ts",
      "default": "./dist/lib/api/services/index.js"
    },
    "./package.json": "./package.json",
    "./*.js": {
      "@bitbybit-dev/source": "./*.js",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "@bitbybit-dev/source": "./*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "type": "module",
  "dependencies": {},
  "devDependencies": {
    "@microsoft/api-extractor": "7.59.0",
    "@vitest/coverage-v8": "4.1.7",
    "shx": "0.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.7"
  }
}
