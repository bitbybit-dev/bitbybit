{
    "extends": "../../../tsconfig.base.cad.json",
    "compileOnSave": false,
    "compilerOptions": {
        "outDir": "./dist",
        "baseUrl": "./",
        "paths": {
            "@bitbybit-dev/base": [
                "../base/dist"
            ],
            "@bitbybit-dev/base/*": [
                "../base/dist/*"
            ],
            "@bitbybit-dev/jscad": [
                "../jscad/dist"
            ],
            "@bitbybit-dev/jscad/*": [
                "../jscad/dist/*"
            ],
            "@bitbybit-dev/jscad-worker": [
                "../jscad-worker/dist"
            ],
            "@bitbybit-dev/jscad-worker/*": [
                "../jscad-worker/dist/*"
            ],
            "@bitbybit-dev/manifold": [
                "../manifold/dist"
            ],
            "@bitbybit-dev/manifold/*": [
                "../manifold/dist/*"
            ],
            "@bitbybit-dev/manifold-worker": [
                "../manifold-worker/dist"
            ],
            "@bitbybit-dev/manifold-worker/*": [
                "../manifold-worker/dist/*"
            ],
            "@bitbybit-dev/occt": [
                "../occt/dist"
            ],
            "@bitbybit-dev/occt/*": [
                "../occt/dist/*"
            ],
            "@bitbybit-dev/occt-worker": [
                "../occt-worker/dist"
            ],
            "@bitbybit-dev/occt-worker/*": [
                "../occt-worker/dist/*"
            ]
        }
    }
}
