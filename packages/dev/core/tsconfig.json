// The editor and test view of this package: the shared CAD base (tsconfig.base.cad.json, the whole strict
// set) plus this package's own paths. The build config, tsconfig.bitbybit.json, is generated from the
// package manifests by scripts/gen-ts-references.mjs and carries the same base.
{
    "extends": "../../../tsconfig.base.cad.json",
    "compileOnSave": false,
    "compilerOptions": {
        "outDir": "./dist/bitbybit-dev",
        "baseUrl": "./",
        "paths": {
            "@bitbybit-dev/base": [
                "../base/dist"
            ],
            "@bitbybit-dev/base/*": [
                "../base/dist/*"
            ],
            "@bitbybit-dev/core": [
                "../core/dist"
            ],
            "@bitbybit-dev/core/*": [
                "../core/dist/*"
            ],
            "@bitbybit-dev/jscad": [
                "../jscad/dist"
            ],
            "@bitbybit-dev/jscad/*": [
                "../jscad/dist/*"
            ],
            "@bitbybit-dev/jscad-worker": [
                "../jscad-worker/dist"
            ],
            "@bitbybit-dev/jscad-worker/*": [
                "../jscad-worker/dist/*"
            ],
            "@bitbybit-dev/manifold": [
                "../manifold/dist"
            ],
            "@bitbybit-dev/manifold/*": [
                "../manifold/dist/*"
            ],
            "@bitbybit-dev/manifold-worker": [
                "../manifold-worker/dist"
            ],
            "@bitbybit-dev/manifold-worker/*": [
                "../manifold-worker/dist/*"
            ],
            "@bitbybit-dev/occt": [
                 "../occt/dist"
            ],
            "@bitbybit-dev/occt/*": [
                "../occt/dist/*"
            ],
            "@bitbybit-dev/occt-worker": [
                "../occt-worker/dist"
            ],
            "@bitbybit-dev/occt-worker/*": [
                "../occt-worker/dist/*"
            ]
        }
    }
}