/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
    "extends": "../../../tsconfig.base.cad-loose.json",
    "compileOnSave": false,
    "exclude": [
        "lib/workers/occ/services/advanced/**/*",
        "./**/*.test.ts"
    ],
    "compilerOptions": {
        "outDir": "./dist",
        "baseUrl": "./",
        "paths": {
            "@bitbybit-dev/base": [
                "../base/dist"
            ],
            "@bitbybit-dev/base/*": [
                "../base/dist/*"
            ],
            "@bitbybit-dev/core": [
                "../core/dist"
            ],
            "@bitbybit-dev/core/*": [
                "../core/dist/*"
            ],
            "@bitbybit-dev/jscad": [
                "../jscad/dist"
            ],
            "@bitbybit-dev/jscad/*": [
                "../jscad/dist/*"
            ],
            "@bitbybit-dev/jscad-worker": [
                "../jscad-worker/dist"
            ],
            "@bitbybit-dev/jscad-worker/*": [
                "../jscad-worker/dist/*"
            ],
            "@bitbybit-dev/manifold": [
                "../manifold/dist"
            ],
            "@bitbybit-dev/manifold/*": [
                "../manifold/dist/*"
            ],
            "@bitbybit-dev/manifold-worker": [
                "../manifold-worker/dist"
            ],
            "@bitbybit-dev/manifold-worker/*": [
                "../manifold-worker/dist/*"
            ],
            "@bitbybit-dev/occt": [
                 "../occt/dist"
            ],
            "@bitbybit-dev/occt/*": [
                "../occt/dist/*"
            ],
            "@bitbybit-dev/occt-worker": [
                "../occt-worker/dist"
            ],
            "@bitbybit-dev/occt-worker/*": [
                "../occt-worker/dist/*"
            ]
        }
    }
}