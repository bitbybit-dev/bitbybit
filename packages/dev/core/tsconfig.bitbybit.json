{
    "extends": "../../../tsconfig.base.cad.json",
    "compileOnSave": false,
    "exclude": [
        "lib/api/inputs/verb/**/*",
        "coverage",
        "dist",
        "lib/workers/occ/services/advanced/**/*",
        "**/__mocks__/**",
        "**/__test__/**",
        "./**/*.test.ts",
        "vitest.config.ts"
    ],
    "compilerOptions": {
        "composite": true,
        "tsBuildInfoFile": "./dist/tsconfig.bitbybit.tsbuildinfo",
        "outDir": "./dist",
        "baseUrl": "./",
        "paths": {
            "@bitbybit-dev/base": [
                "../base/dist"
            ],
            "@bitbybit-dev/base/*": [
                "../base/dist/*"
            ],
            "@bitbybit-dev/jscad": [
                "../jscad/dist"
            ],
            "@bitbybit-dev/jscad/*": [
                "../jscad/dist/*"
            ],
            "@bitbybit-dev/jscad-worker": [
                "../jscad-worker/dist"
            ],
            "@bitbybit-dev/jscad-worker/*": [
                "../jscad-worker/dist/*"
            ],
            "@bitbybit-dev/manifold": [
                "../manifold/dist"
            ],
            "@bitbybit-dev/manifold/*": [
                "../manifold/dist/*"
            ],
            "@bitbybit-dev/manifold-worker": [
                "../manifold-worker/dist"
            ],
            "@bitbybit-dev/manifold-worker/*": [
                "../manifold-worker/dist/*"
            ],
            "@bitbybit-dev/ifc-worker": [
                "../ifc-worker/dist"
            ],
            "@bitbybit-dev/ifc-worker/*": [
                "../ifc-worker/dist/*"
            ],
            "@bitbybit-dev/ifc": [
                "../ifc/dist"
            ],
            "@bitbybit-dev/ifc/*": [
                "../ifc/dist/*"
            ],
            "@bitbybit-dev/occt": [
                "../occt/dist"
            ],
            "@bitbybit-dev/occt/*": [
                "../occt/dist/*"
            ],
            "@bitbybit-dev/occt-worker": [
                "../occt-worker/dist"
            ],
            "@bitbybit-dev/occt-worker/*": [
                "../occt-worker/dist/*"
            ]
        }
    },
    "references": [
        {
            "path": "../base/tsconfig.bitbybit.json"
        },
        {
            "path": "../ifc/tsconfig.bitbybit.json"
        },
        {
            "path": "../ifc-worker/tsconfig.bitbybit.json"
        },
        {
            "path": "../jscad/tsconfig.bitbybit.json"
        },
        {
            "path": "../jscad-worker/tsconfig.bitbybit.json"
        },
        {
            "path": "../manifold/tsconfig.bitbybit.json"
        },
        {
            "path": "../manifold-worker/tsconfig.bitbybit.json"
        },
        {
            "path": "../occt/tsconfig.bitbybit.json"
        },
        {
            "path": "../occt-worker/tsconfig.bitbybit.json"
        }
    ]
}
