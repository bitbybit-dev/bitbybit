/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
    "extends": "../../../tsconfig.base.cad-loose.json",
    "compileOnSave": false,
    "compilerOptions": {
        "outDir": "./dist/bitbybit-dev",
        "baseUrl": "./",
        "paths": {
            "@bitbybit-dev/occt": [
                "../occt"
            ],
            "@bitbybit-dev/occt/*": [
                "../occt/*"
            ],
            "@bitbybit-dev/base": [
                "../base/dist"
            ],
            "@bitbybit-dev/base/*": [
                "../base/dist/*"
            ]
        }
    },
    "exclude": [
        "**/*.test.ts"
    ]
}
