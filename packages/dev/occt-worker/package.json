{
    "name": "@bitbybit-dev/occt-worker",
    "version": "1.1.1",
    "description": "Bit By Bit Developers CAD algorithms using OpenCascade Technology kernel adapted for WebWorker",
    "homepage": "https://docs.bitbybit.dev/classes/Bit.OCCT",
    "main": "index.js",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bitbybit-dev/bitbybit.git",
        "directory": "packages/dev/occt-worker"
    },
    "directories": {
        "lib": "lib"
    },
    "keywords": [
        "Bit By Bit Developers",
        "bitbybit",
        "bitbybit.dev",
        "Geometry",
        "CAD",
        "3D",
        "OCCT",
        "OpenCascade",
        "Parametric",
        "Modeling",
        "Browser",
        "Node",
        "3D algorithms",
        "STEP",
        "STP",
        "3D modeling",
        "3D printing",
        "3D printing algorithms",
        "3D software",
        "OpenCascade Technology",
        "AEC",
        "Automotive",
        "Engineering",
        "CAE",
        "CAM",
        "Worker",
        "WebWorker",
        "WASM"
    ],
    "scripts": {
        "build": "tsc -b tsconfig.bitbybit.json",
        "typecheck:strict": "tsc -p tsconfig.strict.json --pretty false",
        "typecheck:tests": "tsc -p tsconfig.json --noEmit --pretty false",
        "clean-dist": "shx rm -rf dist",
        "build-p": "npm run build && npm run copy-package && npm run copy-readme-license && npm run delete-coverage",
        "copy-package": "node ../../../scripts/dist-manifest.mjs",
        "copy-readme-license": "shx cp -R ./README.md ./dist && shx cp -R ./LICENSE ./dist",
        "delete-coverage": "shx rm -rf ./dist/coverage || true",
        "docs": "./node_modules/.bin/sass ts-doc-theme/assets/css/main.sass ts-doc-theme/assets/css/main.css && node_modules/.bin/typedoc --out ts-api-docs/ lib/api --theme ./ts-doc-theme --excludePrivate --tsconfig lib/api/tsconfig.bbb.json --media assets/images/blockly-block-images/",
        "test": "NODE_OPTIONS=--max-old-space-size=8192 vitest run",
        "test:coverage": "NODE_OPTIONS=--max-old-space-size=8192 vitest run --coverage",
        "test:watch": "NODE_OPTIONS=--max-old-space-size=8192 vitest"
    },
    "author": "Bit by bit developers",
    "license": "MIT",
    "funding": {
        "type": "corporate",
        "url": "https://bitbybit.dev/auth/pick-plan"
    },
    "types": "./index.d.ts",
    "exports": {
        ".": {
            "@bitbybit-dev/source": "./index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./lib": {
            "@bitbybit-dev/source": "./lib/index.ts",
            "types": "./dist/lib/index.d.ts",
            "default": "./dist/lib/index.js"
        },
        "./lib/api": {
            "@bitbybit-dev/source": "./lib/api/index.ts",
            "types": "./dist/lib/api/index.d.ts",
            "default": "./dist/lib/api/index.js"
        },
        "./lib/api/occt": {
            "@bitbybit-dev/source": "./lib/api/occt/index.ts",
            "types": "./dist/lib/api/occt/index.d.ts",
            "default": "./dist/lib/api/occt/index.js"
        },
        "./lib/api/occt/assembly": {
            "@bitbybit-dev/source": "./lib/api/occt/assembly/index.ts",
            "types": "./dist/lib/api/occt/assembly/index.d.ts",
            "default": "./dist/lib/api/occt/assembly/index.js"
        },
        "./lib/api/occt/geom": {
            "@bitbybit-dev/source": "./lib/api/occt/geom/index.ts",
            "types": "./dist/lib/api/occt/geom/index.d.ts",
            "default": "./dist/lib/api/occt/geom/index.js"
        },
        "./lib/api/occt/shapes": {
            "@bitbybit-dev/source": "./lib/api/occt/shapes/index.ts",
            "types": "./dist/lib/api/occt/shapes/index.d.ts",
            "default": "./dist/lib/api/occt/shapes/index.js"
        },
        "./lib/occ-worker": {
            "@bitbybit-dev/source": "./lib/occ-worker/index.ts",
            "types": "./dist/lib/occ-worker/index.d.ts",
            "default": "./dist/lib/occ-worker/index.js"
        },
        "./package.json": "./package.json",
        "./*.js": {
            "@bitbybit-dev/source": "./*.js",
            "types": "./dist/*.d.ts",
            "default": "./dist/*.js"
        },
        "./*": {
            "@bitbybit-dev/source": "./*.ts",
            "types": "./dist/*.d.ts",
            "default": "./dist/*.js"
        }
    },
    "type": "module",
    "dependencies": {
        "@bitbybit-dev/occt": "1.1.1",
        "@bitbybit-dev/base": "1.1.1",
        "rxjs": "7.8.2"
    },
    "devDependencies": {
        "@vitest/coverage-v8": "4.1.7",
        "shx": "0.4.0",
        "typescript": "5.9.3",
        "vitest": "4.1.7"
    }
}
