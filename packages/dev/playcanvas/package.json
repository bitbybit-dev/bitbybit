{
    "name": "@bitbybit-dev/playcanvas",
    "version": "1.2.0-rc.1",
    "description": "Bit By Bit Developers PlayCanvas CAD Library to Program Geometry",
    "homepage": "https://docs.bitbybit.dev/modules/Bit",
    "main": "index.js",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bitbybit-dev/bitbybit.git",
        "directory": "packages/dev/playcanvas"
    },
    "keywords": [
        "Bit By Bit Developers",
        "bitbybit",
        "bitbybit.dev",
        "Geometry",
        "CAD",
        "3D",
        "JSCAD",
        "OCCT",
        "OpenCascade",
        "Creative coding",
        "PlayCanvas",
        "WebGL",
        "WebGPU",
        "Parametric",
        "Modeling",
        "Browser CAD",
        "3D algorithms",
        "3D modeling",
        "3D printing",
        "3D printing algorithms",
        "3D software",
        "OpenCascade Technology",
        "AEC",
        "Automotive",
        "Engineering",
        "CAE",
        "CAM"
    ],
    "directories": {
        "lib": "lib"
    },
    "scripts": {
        "build": "tsc -b tsconfig.bitbybit.json",
        "typecheck:strict": "tsc -p tsconfig.strict.json --pretty false",
        "typecheck:tests": "tsc -p tsconfig.json --noEmit --pretty false",
        "clean-dist": "shx rm -rf dist",
        "build-p": "npm run build && npm run copy-package && npm run copy-readme && npm run delete-coverage",
        "copy-package": "node ../../../scripts/dist-manifest.mjs",
        "copy-readme": "shx cp -R ./README.md ./dist && shx cp -R ./LICENSE ./dist",
        "delete-coverage": "shx rm -rf ./dist/coverage || true",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "api:check": "api-extractor run",
        "api:update": "api-extractor run --local"
    },
    "author": "Bit by bit developers",
    "license": "MIT",
    "funding": {
        "type": "corporate",
        "url": "https://bitbybit.dev/auth/pick-plan"
    },
    "types": "./index.d.ts",
    "exports": {
        ".": {
            "@bitbybit-dev/source": "./index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./lib": {
            "@bitbybit-dev/source": "./lib/index.ts",
            "types": "./dist/lib/index.d.ts",
            "default": "./dist/lib/index.js"
        },
        "./lib/api": {
            "@bitbybit-dev/source": "./lib/api/index.ts",
            "types": "./dist/lib/api/index.d.ts",
            "default": "./dist/lib/api/index.js"
        },
        "./lib/api/bitbybit": {
            "@bitbybit-dev/source": "./lib/api/bitbybit/index.ts",
            "types": "./dist/lib/api/bitbybit/index.d.ts",
            "default": "./dist/lib/api/bitbybit/index.js"
        },
        "./lib/api/bitbybit/playcanvas": {
            "@bitbybit-dev/source": "./lib/api/bitbybit/playcanvas/index.ts",
            "types": "./dist/lib/api/bitbybit/playcanvas/index.d.ts",
            "default": "./dist/lib/api/bitbybit/playcanvas/index.js"
        },
        "./lib/api/inputs": {
            "@bitbybit-dev/source": "./lib/api/inputs/index.ts",
            "types": "./dist/lib/api/inputs/index.d.ts",
            "default": "./dist/lib/api/inputs/index.js"
        },
        "./lib/api/models": {
            "@bitbybit-dev/source": "./lib/api/models/index.ts",
            "types": "./dist/lib/api/models/index.d.ts",
            "default": "./dist/lib/api/models/index.js"
        },
        "./package.json": "./package.json",
        "./*.js": {
            "@bitbybit-dev/source": "./*.js",
            "types": "./dist/*.d.ts",
            "default": "./dist/*.js"
        },
        "./*": {
            "@bitbybit-dev/source": "./*.ts",
            "types": "./dist/*.d.ts",
            "default": "./dist/*.js"
        }
    },
    "type": "module",
    "dependencies": {
        "@bitbybit-dev/core": "1.2.0-rc.1",
        "@bitbybit-dev/base": "1.2.0-rc.1",
        "@bitbybit-dev/occt-worker": "1.2.0-rc.1",
        "@bitbybit-dev/jscad-worker": "1.2.0-rc.1",
        "@bitbybit-dev/manifold-worker": "1.2.0-rc.1",
        "playcanvas": "2.20.0",
        "jsonpath-plus": "10.3.0",
        "verb-nurbs-web": "2.1.3"
    },
    "devDependencies": {
        "@microsoft/api-extractor": "7.59.0",
        "@vitest/coverage-v8": "4.1.11",
        "jsdom": "29.0.1",
        "shx": "0.4.0",
        "typescript": "5.9.3",
        "vitest": "4.1.11"
    }
}
