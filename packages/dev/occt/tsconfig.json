// The editor and test view of this package. The build (tsconfig.bitbybit.json) enforces noImplicitAny and
// strictNullChecks ahead of the shared loose base: occt is the largest package and is going strict one flag at a time,
// the way base did. The flags are repeated here so the editor and the tests hold the same line; the
// build config cannot carry this note because the references generator rewrites it without comments.
{
    "extends": "../../../tsconfig.base.cad-loose.json",
    "compileOnSave": false,
    "compilerOptions": {
        "outDir": "./dist/bitbybit-core",
        "baseUrl": "./",
        "paths": {
            "@bitbybit-dev/base": [
                "../base/dist"
            ],
            "@bitbybit-dev/base/*": [
                "../base/dist/*"
            ]
        },
        "noImplicitAny": true,
        "strictNullChecks": true
    }
}
