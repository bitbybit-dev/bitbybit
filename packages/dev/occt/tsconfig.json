// The editor and test view of this package. The build (tsconfig.bitbybit.json) enforces the whole
// strict set of tsconfig.base.cad-strict.json, ahead of the shared loose base: occt is the largest
// package and the kernel the engine packages build on, and it went strict one flag at a time, the way
// base did. It carries no strict baseline any more. The flags are repeated here so the editor and the
// tests hold the same line; the build config cannot carry this note because the references generator
// rewrites it without comments.
{
    "extends": "../../../tsconfig.base.cad-loose.json",
    "compileOnSave": false,
    "compilerOptions": {
        "outDir": "./dist/bitbybit-core",
        "baseUrl": "./",
        "paths": {
            "@bitbybit-dev/base": [
                "../base/dist"
            ],
            "@bitbybit-dev/base/*": [
                "../base/dist/*"
            ]
        },
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noImplicitReturns": true,
        "noImplicitOverride": true,
        "noPropertyAccessFromIndexSignature": true,
        "isolatedModules": true,
        "forceConsistentCasingInFileNames": true
    }
}
