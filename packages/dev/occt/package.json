{
    "name": "@bitbybit-dev/occt",
    "version": "1.2.0-rc.0",
    "description": "Bit By Bit Developers CAD algorithms using OpenCascade Technology kernel. Run in Node and in Browser.",
    "homepage": "https://docs.bitbybit.dev/classes/Bit.OCCT",
    "main": "index.js",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bitbybit-dev/bitbybit.git",
        "directory": "packages/dev/occt"
    },
    "directories": {
        "lib": "lib"
    },
    "keywords": [
        "Bit By Bit Developers",
        "bitbybit",
        "bitbybit.dev",
        "Geometry",
        "CAD",
        "3D",
        "OCCT",
        "OpenCascade",
        "Parametric",
        "Modeling",
        "Browser",
        "Node",
        "3D algorithms",
        "STEP",
        "STP",
        "3D modeling",
        "3D printing",
        "3D printing algorithms",
        "3D software",
        "OpenCascade Technology",
        "AEC",
        "Automotive",
        "Engineering",
        "CAE",
        "CAM"
    ],
    "scripts": {
        "build": "tsc -b tsconfig.bitbybit.json",
        "typecheck:strict": "tsc -p tsconfig.strict.json --pretty false",
        "typecheck:tests": "tsc -p tsconfig.json --noEmit --pretty false",
        "clean-dist": "shx rm -rf dist",
        "build-p": "npm run fetch-kernels && npm run build && npm run copy-package && npm run copy-occt && npm run copy-readme-license && npm run delete-coverage && npm run delete-bak",
        "copy-package": "node ../../../scripts/dist-manifest.mjs",
        "copy-occt": "shx cp -R ./bitbybit-dev-occt ./dist && shx cp -R ./bitbybit-dev-occt-64-bit ./dist && shx cp -R ./bitbybit-dev-occt-64-bit-mt ./dist",
        "copy-readme-license": "shx cp -R ./README.md ./dist && shx cp -R ./LICENSE ./dist && shx cp -R ./NOTICE ./dist && shx cp -R ./licenses ./dist",
        "delete-coverage": "shx rm -rf ./dist/coverage || true",
        "delete-bak": "find ./dist -name '*.bak' -delete || true",
        "test": "NODE_OPTIONS=--max-old-space-size=8192 vitest run",
        "test:coverage": "NODE_OPTIONS=--max-old-space-size=8192 vitest run --coverage",
        "test:watch": "NODE_OPTIONS=--max-old-space-size=8192 vitest",
        "fetch-kernels": "node ../../../scripts/fetch-kernels.mjs",
        "api:check": "api-extractor run",
        "api:update": "api-extractor run --local"
    },
    "author": "Bit by bit developers",
    "license": "MIT",
    "funding": {
        "type": "corporate",
        "url": "https://bitbybit.dev/auth/pick-plan"
    },
    "types": "./index.d.ts",
    "exports": {
        ".": {
            "@bitbybit-dev/source": "./index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./lib": {
            "@bitbybit-dev/source": "./lib/index.ts",
            "types": "./dist/lib/index.d.ts",
            "default": "./dist/lib/index.js"
        },
        "./lib/api": {
            "@bitbybit-dev/source": "./lib/api/index.ts",
            "types": "./dist/lib/api/index.d.ts",
            "default": "./dist/lib/api/index.js"
        },
        "./lib/api/inputs": {
            "@bitbybit-dev/source": "./lib/api/inputs/index.ts",
            "types": "./dist/lib/api/inputs/index.d.ts",
            "default": "./dist/lib/api/inputs/index.js"
        },
        "./lib/api/models": {
            "@bitbybit-dev/source": "./lib/api/models/index.ts",
            "types": "./dist/lib/api/models/index.d.ts",
            "default": "./dist/lib/api/models/index.js"
        },
        "./lib/services": {
            "@bitbybit-dev/source": "./lib/services/index.ts",
            "types": "./dist/lib/services/index.d.ts",
            "default": "./dist/lib/services/index.js"
        },
        "./lib/services/assembly": {
            "@bitbybit-dev/source": "./lib/services/assembly/index.ts",
            "types": "./dist/lib/services/assembly/index.d.ts",
            "default": "./dist/lib/services/assembly/index.js"
        },
        "./lib/services/geom": {
            "@bitbybit-dev/source": "./lib/services/geom/index.ts",
            "types": "./dist/lib/services/geom/index.d.ts",
            "default": "./dist/lib/services/geom/index.js"
        },
        "./lib/services/shapes": {
            "@bitbybit-dev/source": "./lib/services/shapes/index.ts",
            "types": "./dist/lib/services/shapes/index.d.ts",
            "default": "./dist/lib/services/shapes/index.js"
        },
        "./bitbybit-dev-occt/bitbybit-dev-occt": {
            "@bitbybit-dev/source": "./bitbybit-dev-occt/bitbybit-dev-occt.js",
            "types": "./dist/bitbybit-dev-occt/bitbybit-dev-occt.d.ts",
            "default": "./dist/bitbybit-dev-occt/bitbybit-dev-occt.js"
        },
        "./bitbybit-dev-occt/index": {
            "@bitbybit-dev/source": "./bitbybit-dev-occt/index.js",
            "types": "./dist/bitbybit-dev-occt/index.d.ts",
            "default": "./dist/bitbybit-dev-occt/index.js"
        },
        "./bitbybit-dev-occt/*": {
            "@bitbybit-dev/source": "./bitbybit-dev-occt/*",
            "types": "./dist/bitbybit-dev-occt/*",
            "default": "./dist/bitbybit-dev-occt/*"
        },
        "./bitbybit-dev-occt-64-bit/bitbybit-dev-occt-64-bit": {
            "@bitbybit-dev/source": "./bitbybit-dev-occt-64-bit/bitbybit-dev-occt-64-bit.js",
            "types": "./dist/bitbybit-dev-occt-64-bit/bitbybit-dev-occt-64-bit.d.ts",
            "default": "./dist/bitbybit-dev-occt-64-bit/bitbybit-dev-occt-64-bit.js"
        },
        "./bitbybit-dev-occt-64-bit/index": {
            "@bitbybit-dev/source": "./bitbybit-dev-occt-64-bit/index.js",
            "types": "./dist/bitbybit-dev-occt-64-bit/index.d.ts",
            "default": "./dist/bitbybit-dev-occt-64-bit/index.js"
        },
        "./bitbybit-dev-occt-64-bit/*": {
            "@bitbybit-dev/source": "./bitbybit-dev-occt-64-bit/*",
            "types": "./dist/bitbybit-dev-occt-64-bit/*",
            "default": "./dist/bitbybit-dev-occt-64-bit/*"
        },
        "./bitbybit-dev-occt-64-bit-mt/bitbybit-dev-occt-64-bit-mt": {
            "@bitbybit-dev/source": "./bitbybit-dev-occt-64-bit-mt/bitbybit-dev-occt-64-bit-mt.js",
            "types": "./dist/bitbybit-dev-occt-64-bit-mt/bitbybit-dev-occt-64-bit-mt.d.ts",
            "default": "./dist/bitbybit-dev-occt-64-bit-mt/bitbybit-dev-occt-64-bit-mt.js"
        },
        "./bitbybit-dev-occt-64-bit-mt/index": {
            "@bitbybit-dev/source": "./bitbybit-dev-occt-64-bit-mt/index.js",
            "types": "./dist/bitbybit-dev-occt-64-bit-mt/index.d.ts",
            "default": "./dist/bitbybit-dev-occt-64-bit-mt/index.js"
        },
        "./bitbybit-dev-occt-64-bit-mt/*": {
            "@bitbybit-dev/source": "./bitbybit-dev-occt-64-bit-mt/*",
            "types": "./dist/bitbybit-dev-occt-64-bit-mt/*",
            "default": "./dist/bitbybit-dev-occt-64-bit-mt/*"
        },
        "./package.json": "./package.json",
        "./*.js": {
            "@bitbybit-dev/source": "./*.js",
            "types": "./dist/*.d.ts",
            "default": "./dist/*.js"
        },
        "./*": {
            "@bitbybit-dev/source": "./*.ts",
            "types": "./dist/*.d.ts",
            "default": "./dist/*.js"
        }
    },
    "type": "module",
    "dependencies": {
        "@bitbybit-dev/base": "1.2.0-rc.0"
    },
    "devDependencies": {
        "@microsoft/api-extractor": "7.59.0",
        "@vitest/coverage-v8": "4.1.7",
        "shx": "0.4.0",
        "typescript": "5.9.3",
        "vitest": "4.1.7"
    }
}
