// The editor and test view of this package. It extends the shared CAD base like every other package,
// so the whole strict set applies here too, and states only what genuinely differs: this is a Node
// CLI rather than a browser bundle, so it compiles as NodeNext at ES2022 with no DOM library, and it
// ships source maps and declaration maps. The scaffold templates are not compiled - they are copied.
{
    "extends": "../../../tsconfig.base.cad.json",
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2022"],
        "outDir": "./dist",
        "rootDir": "./src",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "declarationMap": true,
        "sourceMap": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist", "templates", "src/**/*.test.ts", "vitest.config.ts"]
}
