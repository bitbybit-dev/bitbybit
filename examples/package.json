{
    "name": "bitbybit-examples",
    "version": "1.2.0",
    "description": "Monorepo for browser CAD which holds bitbybit.dev npm packages",
    "scripts": {
        "list": "node scripts/examples.mjs list",
        "verify": "node scripts/examples.mjs verify",
        "verify:heavy": "node scripts/examples.mjs verify --heavy",
        "install:all": "node scripts/examples.mjs install",
        "build:all": "node scripts/examples.mjs build",
        "audit:all": "node scripts/examples.mjs audit",
        "refresh-lockfiles": "node scripts/examples.mjs refresh",
        "status:local": "node scripts/local.mjs status",
        "link:local": "node scripts/local.mjs link",
        "unlink:local": "node scripts/local.mjs unlink",
        "dev:local": "node scripts/local.mjs dev",
        "build:local": "node scripts/local.mjs build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bitbybit-dev/bitbybit.git"
    },
    "keywords": [
        "CAD",
        "3D",
        "Geometry",
        "OCCT",
        "JSCAD",
        "Manifold",
        "ThreeJS",
        "BabylonJS",
        "Automotive",
        "AEC"
    ],
    "author": "Bit By Bit Developers",
