{
    "name": "docs",
    "version": "1.2.0",
    "private": true,
    "scripts": {
        "docusaurus": "docusaurus",
        "generate-llms": "node scripts/generate-llms.js",
        "generate-api-docs": "docusaurus gen-api-docs openapi-docs",
        "clean-api-docs": "docusaurus clean-api-docs openapi-docs",
        "start": "npm run generate-llms && docusaurus start",
        "build": "npm run generate-llms && npm run clean-api-docs && npm run generate-api-docs && npm run inject-openapi-static && docusaurus build && npm run check-descriptions",
        "inject-openapi-static": "node scripts/inject-openapi-static.js",
        "check-descriptions": "node scripts/check-descriptions.js",
        "swizzle": "docusaurus swizzle",
        "deploy": "docusaurus deploy",
        "clear": "docusaurus clear",
        "serve": "docusaurus serve",
        "write-translations": "docusaurus write-translations",
        "write-heading-ids": "docusaurus write-heading-ids",
        "typecheck": "tsc"
    },
    "dependencies": {
        "@docusaurus/core": "3.10.2",
        "@docusaurus/preset-classic": "3.10.2",
        "@docusaurus/theme-mermaid": "3.10.2",
        "@mdx-js/react": "^3.0.0",
        "clsx": "^2.0.0",
        "docusaurus-plugin-openapi-docs": "^5.2.0",
        "docusaurus-plugin-sass": "^0.2.6",
        "docusaurus-theme-openapi-docs": "^5.2.0",
        "mermaid": "11.17.2",
        "path-browserify": "^1.0.1",
        "prism-react-renderer": "^2.3.0",
        "react": "^19.0.0",
        "react-cookie-consent": "^10.0.2",
        "react-dom": "^19.0.0",
        "sass": "^1.99.0"
    },
    "devDependencies": {
        "@docusaurus/module-type-aliases": "3.10.2",
        "@docusaurus/tsconfig": "3.10.2",
        "@docusaurus/types": "3.10.2",
        "typescript": "~7.0.2"
    },
    "browserslist": {
        "production": [
            ">0.5%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 3 chrome version",
            "last 3 firefox version",
            "last 5 safari version"
        ]
    },
    "engines": {
        "node": ">=18.0"
    },
    "overrides": {
        "js-yaml@4": "^4.3.2",
        "qs": "^6.16.0",
        "yaml": "^1.10.3",
        "serialize-javascript": "^7.1.1",
        "uuid": "^11.1.1"
    }
}
