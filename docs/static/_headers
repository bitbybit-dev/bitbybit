# Cloudflare Pages headers for learn.bitbybit.dev

# ── Global: security headers ──
# Indexing is opt-OUT, not opt-in. A blanket X-Robots-Tag here silently noindexes every
# favicon, social card and sitemap the moment a new asset directory is added, which is
# exactly what happened to /favicon.ico and /img/*. Only list what must NOT be indexed.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

# ── Build output: never content ──
/assets/js/*
  X-Robots-Tag: noindex, nofollow

/assets/css/*
  X-Robots-Tag: noindex, nofollow

# ── Source/licence files that ship to the root but are not content ──
/llms.template.txt
  X-Robots-Tag: noindex, nofollow

/LICENSE
  X-Robots-Tag: noindex, nofollow

# ── The error page ──
/404
  X-Robots-Tag: noindex

/404.html
  X-Robots-Tag: noindex

# ── Docs sections embedded in the Shopify admin need framing ──
/learn
  ! X-Frame-Options
  Content-Security-Policy: frame-ancestors 'self' https://admin.shopify.com https://*.myshopify.com https://dev-3d-bits-a6ca0f32432a.herokuapp.com https://prod-3d-bits-baaef5dd0fce.herokuapp.com

